#!/bin/sh
# ===========================================================================
# KRONOS CENTRAL — auto-deploy do mobile
# Sempre que a branch main for enviada (git push), publica automaticamente a
# pasta www/ no GitHub Pages (branch gh-pages). Assim a versão mobile
# (https://filosofiaempreendedora00.github.io/kronos-central/) atualiza
# sozinha — sem rebuild, sem comando extra.
# ===========================================================================

# Evita recursão: o próprio deploy faz um git push para gh-pages.
[ -n "$KRONOS_DEPLOYING" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "↻ KRONOS: publicando www/ no GitHub Pages (gh-pages)…"
      if KRONOS_DEPLOYING=1 git subtree push --prefix www origin gh-pages; then
        echo "✓ KRONOS: mobile atualizado."
      else
        echo "⚠ KRONOS: deploy do Pages falhou — rode 'npm run deploy:web' manualmente."
      fi
      ;;
  esac
done

exit 0
