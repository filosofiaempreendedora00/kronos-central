{
  "name": "kronos-central",
  "version": "1.0.0",
  "description": "KRONOS CENTRAL — central de operação e agentes de IA da KRONOS (web, desktop Mac via Electron, iOS via Capacitor).",
  "author": "KRONOS",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "python3 -m http.server 4599 --directory www",
    "dist:mac": "electron-builder --mac",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "build": {
    "appId": "com.kronos.central",
    "productName": "KRONOS Central",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.6",
    "electron": "^42.3.3"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.6",
    "@capacitor/ios": "^7.6.6"
  }
}
